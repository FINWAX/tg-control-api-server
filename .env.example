# Infra config only. Copy to .env and fill.
# Tenant creds (api_id/api_hash, bot tokens, phones, proxies) do NOT go here -
# they are sent to the API and stored encrypted in Postgres.

# AES-256 master key for the secret store: base64 of 32 bytes.
# Generate one with:  openssl rand -base64 32
MASTER_KEY=

# Bearer token gating the gateway API. Every request except GET /healthz must
# send:  Authorization: Bearer <API_TOKEN>. The gateway refuses to start without
# it. Generate one with:  openssl rand -base64 32
API_TOKEN=

# Postgres credentials (optional). The compose file falls back to these dev-only
# defaults when unset; override them for anything but local development. The
# gateway/worker DATABASE_URL is composed from the same values automatically.
# POSTGRES_USER=tgapi
# POSTGRES_PASSWORD=tgapi
# POSTGRES_DB=tgapi

# File uploads (optional). Files are stored on a volume shared between the
# gateway (which writes them) and the workers (which read them via
# inputFileLocal). Defaults shown; override only if needed.
# UPLOADS_DIR=/uploads
# MAX_SINGLE_SHOT_BYTES=67108864     # 64 MiB — single POST /v1/files body cap
# MAX_CHUNK_BYTES=16777216           # 16 MiB — per resumable chunk (PATCH) cap
# MAX_UPLOAD_BYTES=2147483648        # 2 GiB  — total upload cap (Telegram ceiling)
# UPLOAD_TTL=2h                      # abandoned/sent uploads older than this are swept

# Observability (optional). Set an OTLP endpoint to export traces, metrics, and
# logs via OpenTelemetry; logs also keep printing to stdout. Standard OTEL_*
# variables apply (OTEL_EXPORTER_OTLP_HEADERS, _PROTOCOL, OTEL_SERVICE_NAME, ...).
# Leave unset to disable telemetry (plain stdout logging only).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4317
